// firestore.rules — volunteers can submit/withdraw; managers approve/reset.
// Supervisors can view; managers can edit catalog and approvals.
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ----- Helpers -----
    function isAuthed() { return request.auth != null; }
    function isOwner(uid) { return isAuthed() && request.auth.uid == uid; }
    function userRole(uid) {
      return get(/databases/$(db)/documents/users/$(uid)).data.systemRole;
    }
    function isManager() { return isAuthed() && userRole(request.auth.uid) == 'manager'; }
    function isSupervisor() { return isAuthed() && userRole(request.auth.uid) == 'supervisor'; }

    // Allow managers/supervisors to read the collection group "entries" anywhere,
    // so collectionGroup('entries') in useApprovals can succeed.
    match /{path=**}/entries/{stepId} {
      allow read: if isManager() || isSupervisor();
    }
    
    // Add alongside your other helpers (keep your existing rules intact)
    match /databases/{db}/documents/{path=**}/progress/{roleId} {
      allow read: if isManager() || isSupervisor();
    }

    // ===== Users root (profile) =====
    match /users/{uid} {
      // Owner, supervisors, and managers can read user profiles
      allow read: if isOwner(uid) || isSupervisor() || isManager();

      // Owner can create their own profile (AuthContext.ensureUserProfile)
      allow create: if isOwner(uid);

      // Owner can update their own profile but cannot escalate systemRole
      allow update: if isOwner(uid) &&
                    (request.resource.data.systemRole == resource.data.systemRole);

      // Managers can update/delete any user document (e.g., assign roles/permissions)
      allow update, delete: if isManager();

      // ===== Per-role progress =====
      match /progress/{roleId} {
        // Visibility
        allow read: if isOwner(uid) || isSupervisor() || isManager();

        // Owner may create their progress doc and update ONLY the top-level "steps" map.
        // Managers may update anything (e.g., set to "completed").
        allow create: if isOwner(uid);
        allow update: if (isOwner(uid) &&
                          request.resource.data.diff(resource.data).changedKeys().hasOnly(['steps']))
                       || isManager();
        // Deleting an entire progress doc: managers only
        allow delete: if isManager();

        // Per-step submission entries (review queue)
        match /entries/{stepId} {
          // Visibility for owner/supervisor/manager
          allow read: if isOwner(uid) || isSupervisor() || isManager();

          // Volunteer actions: submit (create) and withdraw (delete)
          allow create: if isOwner(uid);
          allow update: if isOwner(uid);

          // Manager actions: approve / request changes via updates
          allow update: if isManager();
        }
      }

      // Reusable credentials for shareable steps (CRC, etc.)
      match /credentials/{credId} {
        // Owner, supervisor, manager can read
        allow read: if isOwner(uid) || isSupervisor() || isManager();
        // Owner can create/update their own credential; managers can also update (e.g., verify)
        allow create, update: if isOwner(uid) || isManager();
      }
    }

    // ===== Catalog =====
    match /roles/{roleId} {
      // Any signed-in user can read roles
      allow read: if isAuthed();
      // Managers manage catalog
      allow create, update, delete: if isManager();
    }

    match /steps/{stepId} {
      // Any signed-in user can read step definitions
      allow read: if isAuthed();
      // Managers manage steps
      allow create, update, delete: if isManager();
    }
  }
}
